# Plantilla de variables de entorno.
# Cópiala como .env (cp .env.example .env) y ajusta los valores.
# El fichero .env NO se sube a Git (está en .gitignore).

# Servidor de la base de datos. OBLIGATORIA en el lab: el endpoint de RDS
# (algo como muro-notas.xxxxxxxx.us-east-1.rds.amazonaws.com).
# En desarrollo se ignora: docker-compose.yml usa el contenedor "postgres".
DB_HOST=pon-aqui-el-endpoint-de-rds

# Puerto de PostgreSQL (por defecto 5432)
DB_PORT=5432

# Nombre de la base de datos (por defecto muronotas). En RDS debe existir ya.
DB_NAME=muronotas

# Usuario de la base de datos (por defecto postgres)
DB_USER=postgres

# Contraseña del usuario. OBLIGATORIA, sin valor por defecto.
# Clave de laboratorio común para toda la clase; en un proyecto real iría en un gestor de secretos.
DB_PASSWORD=MuroNotas_Lab_2026!

# SSL con la base de datos: require (por defecto, para RDS) o disable.
# En desarrollo se ignora: docker-compose.yml fuerza disable.
DB_SSLMODE=require
